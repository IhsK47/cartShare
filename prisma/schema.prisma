// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// fieldname datatype  @decorators

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}


model Cart {
  id        Int     @id @default(autoincrement())
  name      String
  joinCode  String  @unique
  users     UserInCart[]
  items     Item[]
}

model User {
  id    Int   @id @default(autoincrement())
  name  String
  role  Role  
  carts UserInCart[]
}

model Item {
   id  Int       @id @default(autoincrement())
  name String
  cartId Int
  cart Cart  @relation(fields: [cartId], references: [id])
}

model UserInCart {
  userId Int    //this is the data in the db, whereas next line is the relation
  user  User    @relation(fields: [userId], references: [id]) //field has to ref an already existing field, 
  cartId Int
  cart  Cart    @relation(fields: [cartId], references: [id])

  @@id([userId, cartId]) // Composite ID

}


enum Role {
  OWNER
  USER 
}

